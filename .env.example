# Copy this file to .env and replace the password before starting PostgreSQL.
PORT=3000
# Local default is 127.0.0.1; production defaults to 0.0.0.0. HOST can override it.
NODE_ENV=development
HOST=
# Both blank disables preview authentication locally. Production requires both,
# a password of at least 16 characters, and HTTPS through a trusted proxy.
PREVIEW_USERNAME=
PREVIEW_PASSWORD=
# Leave blank locally. In production trust only the actual ingress IP/CIDR(s).
TRUST_PROXY=
# Leave blank for local Docker. Production requires verify-full and trusted TLS.
PGSSLMODE=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=floorflow
PGUSER=floorflow
PGPASSWORD=replace_with_a_local_development_password

# Separate PostgreSQL login used only for validated assistant queries.
AI_PGUSER=floorflow_ai
AI_PGPASSWORD=replace_with_a_different_local_password

# Leave blank to disable model calls. No Azure resource is created by this app.
# Use the full Azure resource v1 endpoint, including the trailing slash.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_MODEL=
AZURE_FOUNDRY_API_KEY=
