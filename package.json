{
  "name": "floorflow",
  "version": "0.1.0",
  "private": true,
  "description": "A small flooring contractor application built one milestone at a time.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1",
    "db:assistant:setup": "node --env-file-if-exists=.env scripts/setup-assistant-db.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "openai": "7.57.0",
    "pg": "8.23.1",
    "pgsql-ast-parser": "12.0.2"
  }
}
