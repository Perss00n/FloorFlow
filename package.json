{
  "name": "floorflow",
  "version": "0.1.0",
  "private": true,
  "description": "A small flooring contractor application built one milestone at a time.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "node --env-file=.env --test --test-concurrency=1"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1"
  }
}
